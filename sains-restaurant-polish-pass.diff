+export type MenuItem = {
+  name: string;
+  description: string;
+  price: number;
+  category: string;
+};
+
+export type MenuCategory = {
+  id: string;
+  title: string;
+  description: string;
+  items: MenuItem[];
+};
+
+/** Formats a KES price for display, e.g. 1200 -> "KSh 1,200" */
+export function formatPrice(price: number): string {
+  return `KSh ${price.toLocaleString('en-KE')}`;
+}
